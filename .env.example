# Copy this file to `.env` and fill in your real values.
# The `.env` file is NOT tracked by git (see .gitignore).
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: Gemini model. Defaults to gemini-1.5-flash if unset.
GEMINI_MODEL=gemini-1.5-flash

# Optional: cost tracking per 1M tokens (USD). If left 0, cost is NOT
# calculated and token usage is reported instead.
GEMINI_INPUT_COST_PER_1M=0.0
GEMINI_OUTPUT_COST_PER_1M=0.0